# 环境配置文件示例
# 复制此文件为 .env 并修改相应的值

# 服务器端口（默认 3000）
PORT=3000

# 服务器监听地址（生产环境使用 0.0.0.0，开发环境可用 localhost）
HOST=0.0.0.0

# Node 环境（development | production）
NODE_ENV=production

# 数据库路径（可选，默认为 ./data/poker.sqlite）
# DB_PATH=./data/poker.sqlite

# 日志级别（可选）
# LOG_LEVEL=info

# —— 机器人出牌节奏（默认即极限速度，改完重启生效）——
# BOT_THINK_SCALE=1        # 思考时长全局倍率 0.1~10（同时作用于上下限），想变慢设 3~5
# BOT_THINK_MIN_MS=50      # scale=1 时的思考时长硬下限 0~250
# BOT_THINK_MAX_MS=250     # scale=1 时的思考时长硬上限 50~4500，想恢复旧节奏设 1500
# GAME_TICK_MS=200         # 引擎 tick 周期 50~1000，调大则机器人出牌整体变慢
